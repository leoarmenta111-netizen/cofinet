# Runtime identity
APP_ENV=development
DEBUG=false
APP_NAME=CofiNet+ API
APP_VERSION=1.0.0

# PostgreSQL
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=cofinet
DATABASE_USER=cofinet
DATABASE_PASSWORD=replace-with-a-strong-unique-password

# Authentication (generate at least 32 random bytes per environment)
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser/API origins. Pydantic expects a JSON array.
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
FRONTEND_URL=http://localhost:8080

# Mercado Pago. Use sandbox credentials outside production.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MEMBERSHIP_WEBHOOK_URL=

# MikroTik. Use a dedicated non-production router/account in dev and QA.
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
# Must already exist on the non-production router with shared-users=1.
MIKROTIK_INTERNAL_PROFILE=internal-devices

# Compose/Nginx host settings
PUBLIC_DOMAIN=example.invalid
LETSENCRYPT_EMAIL=admin@example.invalid
LETSENCRYPT_STAGING=1
CERTBOT_DATA_PATH=./certbot
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=cofinet-dev_postgres_data

# Optional credentials used only by backend/test_mikrotik.py.
MIKROTIK_TEST_HOTSPOT_USERNAME=
MIKROTIK_TEST_HOTSPOT_PASSWORD=
