# Copy to .env.production on the VPS and inject real secrets there.
APP_ENV=production
DEBUG=false
APP_NAME=CofiNet+ API
APP_VERSION=1.0.0
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=cofinet
DATABASE_USER=cofinet
DATABASE_PASSWORD=REPLACE_ME
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["https://your-domain.example"]
FRONTEND_URL=https://your-domain.example
MERCADOPAGO_ACCESS_TOKEN=REPLACE_ME
MERCADOPAGO_PUBLIC_KEY=REPLACE_ME
MEMBERSHIP_WEBHOOK_URL=
MIKROTIK_HOST=REPLACE_ME
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=REPLACE_ME
MIKROTIK_PASSWORD=REPLACE_ME
PUBLIC_DOMAIN=your-domain.example
LETSENCRYPT_EMAIL=admin@your-domain.example
LETSENCRYPT_STAGING=0
CERTBOT_DATA_PATH=./certbot
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=cofinet_postgres_data
MIKROTIK_TEST_HOTSPOT_USERNAME=
MIKROTIK_TEST_HOTSPOT_PASSWORD=
